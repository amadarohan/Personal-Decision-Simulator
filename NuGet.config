<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Deterministic package sources for this solution.

    The machine-wide NuGet configuration contains a legacy V2 feed
    (nexus3.dotin.ir/repository/XBank-WePod) that intermittently returns
    NU1301 for public packages. It is intentionally excluded here so that
    restore is reproducible on this restricted network.

    If your organisation requires the internal feed, add it back below.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotin-proxy" value="https://nexus3.dotin.ir/repository/nuget-v3-org-proxy/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
