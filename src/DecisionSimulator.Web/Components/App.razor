@using DecisionSimulator.Web.Localization
@using DecisionSimulator.Web.Services
@inject DisplayFormatter Formatter
@inject LanguageService Language

<!DOCTYPE html>
<html lang="@Language.CurrentTag" dir="@(Language.IsRightToLeft ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Personal Decision Simulator</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>

<body>
    @* The render mode is declared here rather than on each page: every screen
       posts forms and handles clicks, so the whole tree must be interactive.
       Without it the app renders as static HTML and no handler ever runs. *@
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    /// <summary>
    /// The document element is rendered here, before any page, so the language
    /// must be resolved first. Otherwise the first paint would use the default
    /// direction and then flip once a page loaded.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await Language.EnsureLoadedAsync();
    }
}
